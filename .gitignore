# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# sing-box 编译产物与远程拉取的源码（build.sh 重建）
/core/sing-box/
/core/output/
/core/.cache/
/libcore/bin/*
/libcore/include/

# 平台二进制 / framework（一律 gitignored，通过 GitHub Release 分发）
*.dylib
*.so
*.dll
*.a
*.aar
*.jar
*.xcframework/
*.framework/

# 平台 libcore 二进制不入 git（走 GitHub Release tag libcore-v<sing-box-ver>，
# CI / 本地用 bin/fetch-libcore.sh 拉）。
# 例外：android gradle wrapper jar 必须入库。
!android/gradle/wrapper/gradle-wrapper.jar

# Flutter ephemeral
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# 生成代码：本仓库选择提交 *.g.dart / *.freezed.dart 以便 fresh clone 即可运行

# 内部 AI 协作设计文档 / 实现计划（不公开）
docs/superpowers/

# 本地视觉构思伴随工具的会话文件
.superpowers/

# 本地隔离开发工作区
.worktrees/

# Flutter 生成文件：含本机绝对路径，不应入库
.flutter-plugins
.flutter-plugins-dependencies
