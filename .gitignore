# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# sing-box 编译产物与远程拉取的源码（build.sh 重建）
/core/sing-box/
/core/output/
/core/.cache/
/libcore/bin/
/libcore/include/

# 平台二进制 / framework（绝大多数 gitignored）
*.dylib
*.so
*.a
*.aar
*.jar
*.xcframework/
*.framework/

# 例外：android/app/libs/libcore.aar 通过 Git LFS 入库，让 CI 能编 Android
# release APK。否则 PR 上 build-android 永远失败。其他 .dylib/.so/.dll 仍按
# 平台本地 build.sh 编译。
!android/app/libs/libcore.aar

# Flutter ephemeral
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# 生成代码：本仓库选择提交 *.g.dart / *.freezed.dart 以便 fresh clone 即可运行

# 内部 AI 协作设计文档 / 实现计划（不公开）
docs/superpowers/
