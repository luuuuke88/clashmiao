//
//  Base.xcconfig
//  ClashMiao – shared build configuration for Runner + tunnel extension
//
//  GPL-3.0 License
//  Copyright (c) 2026 ClashMiao Contributors
//
//  Centralises the bundle identifier roots and signing team so that the
//  main app and the packet tunnel extension stay aligned. Override these
//  values per environment (Debug/Release) by layering additional
//  xcconfig files on top of this one in the Xcode build settings UI.
//

// The tunnel extension's build configurations are based on this file alone,
// not on Flutter/{Debug,Release}.xcconfig, so it never saw FLUTTER_BUILD_NAME /
// FLUTTER_BUILD_NUMBER: its CFBundleVersion came out empty and iOS refused to
// install the app. Pull in Flutter's generated settings here — the extension's
// version must match the app's for App Store uploads anyway.
#include? "Flutter/Generated.xcconfig"

// Root identifier used as the prefix for both the application bundle id
// and the App Group. The runtime entitlements derive `group.<this>` from
// it (see Runner.entitlements / SingBoxPacketTunnel.entitlements).
BASE_BUNDLE_IDENTIFIER = com.clashmiao.shared

// Method/Event channel namespace shared with the Dart side
// (`PlatformBoxService._channelPrefix`). Do not change unless you also
// update lib/core/box_service/platform_box_service.dart.
SERVICE_IDENTIFIER = com.clashmiao.app

// Apple Developer team id. Leave blank locally and let Xcode auto-pick,
// or set explicitly for CI signing.
DEVELOPMENT_TEAM =

// CocoaPods sandbox paths — required by the [CP] Check Pods Manifest.lock
// build phase in SingBoxPacketTunnel (which uses Base.xcconfig instead of
// the CocoaPods-generated xcconfig as its base configuration).
PODS_ROOT = ${SRCROOT}/Pods
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.

// Libcore.xcframework references libresolv DNS resolver symbols
// (_res_9_nclose / _res_9_ninit / _res_9_nsearch). libresolv is a private
// Apple framework so it must be linked explicitly rather than pulled in via
// the framework linker search path.
OTHER_LDFLAGS = $(inherited) -lresolv
