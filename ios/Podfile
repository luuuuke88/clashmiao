#
# ClashMiao iOS Podfile.
#
# Adds the SingBoxPacketTunnel network-extension target alongside the
# main Runner app. The extension intentionally pulls only what it needs
# - it does NOT include Flutter pods, since the extension process runs
# the libcore tunnel directly and never embeds a FlutterEngine.

platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def clashmiao_install_ios_plugin_pods(application_path)
  relative_symlink_dir = '.symlinks'
  platform = 'ios'
  symlink_dir = File.expand_path(relative_symlink_dir, application_path)
  system('rm', '-rf', symlink_dir)

  symlink_plugins_dir = File.expand_path('plugins', symlink_dir)
  system('mkdir', '-p', symlink_plugins_dir)

  plugins_file = File.join(application_path, '..', '.flutter-plugins-dependencies')
  dependencies_hash = flutter_parse_plugins_file(plugins_file)
  plugin_pods = flutter_get_plugins_list(dependencies_hash, platform)
  swift_package_manager_enabled = flutter_get_swift_package_manager_enabled(dependencies_hash, platform)

  plugin_pods.each do |plugin_hash|
    plugin_name = plugin_hash['name']
    plugin_path = plugin_hash['path']
    has_native_build = plugin_hash.fetch('native_build', true)
    next unless plugin_name && plugin_path && has_native_build

    shared_darwin_source = plugin_hash.fetch('shared_darwin_source', false)
    platform_directory = shared_darwin_source ? 'darwin' : platform
    symlink = File.join(symlink_plugins_dir, plugin_name)
    File.symlink(plugin_path, symlink)

    relative = flutter_relative_path_from_podfile(symlink)
    swift_package_exists = File.exist?(File.join(relative, platform_directory, plugin_name, 'Package.swift'))
    next if swift_package_manager_enabled && swift_package_exists
    next if swift_package_exists && !File.exist?(File.join(relative, platform_directory, plugin_name + '.podspec'))

    options = { path: File.join(relative, platform_directory) }
    options[:configurations] = ['Debug'] if plugin_hash.fetch('dev_dependency', false)
    pod plugin_name, options
  end
end

def clashmiao_install_all_ios_pods(application_path)
  flutter_install_ios_engine_pod(application_path)
  clashmiao_install_ios_plugin_pods(application_path)
end

# --- Main application target -------------------------------------------------
target 'Runner' do
  use_frameworks!

  clashmiao_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# --- Packet-tunnel network extension target ----------------------------------
# This target must be created in Xcode first (see ios/SCAFFOLDING.md). Once
# Xcode knows about it, `pod install` will configure pods correctly even
# though the extension does not currently link any CocoaPods.
target 'SingBoxPacketTunnel' do
  use_frameworks!
  # No pods needed today; libcore.xcframework is linked directly via Xcode.
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
