{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "select"
      },
      {
        "type": "udp",
        "tag": "dns-direct",
        "server": "223.5.5.5"
      },
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "rules": [
      {
        "domain": [
          "wg.example.net"
        ],
        "action": "route",
        "server": "dns-direct"
      },
      {
        "domain": [
          "cp.cloudflare.com"
        ],
        "action": "route",
        "server": "dns-remote",
        "rewrite_ttl": 3000
      }
    ],
    "final": "dns-remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/28"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "endpoint_independent_nat": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "127.0.0.1",
      "listen_port": 6450
    }
  ],
  "outbounds": [
    {
      "default": "auto",
      "outbounds": [
        "auto",
        "wg-hk"
      ],
      "tag": "select",
      "type": "selector"
    },
    {
      "idle_timeout": "6000s",
      "interval": "600s",
      "outbounds": [
        "wg-hk"
      ],
      "tag": "auto",
      "type": "urltest",
      "url": "http://connectivitycheck.gstatic.com/generate_204"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "direct-fragment",
      "type": "direct",
      "udp_fragment": true
    },
    {
      "tag": "bypass",
      "type": "direct"
    }
  ],
  "endpoints": [
    {
      "address": [
        "10.8.0.2/32"
      ],
      "peers": [
        {
          "address": "wg.example.net",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ],
          "port": 51820,
          "public_key": "60AVhF+4EZu2jjRIqzo3DtD2AY13Ny4mIbiD1Pfmx3g="
        }
      ],
      "private_key": "NKcDKFSOq65EpLrGnZkHzBKzQ4Y9vp5T8kFQtS0LhkU=",
      "tag": "wg-hk",
      "type": "wireguard"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": [
          "dns"
        ],
        "action": "hijack-dns"
      },
      {
        "inbound": [
          "dns-in"
        ],
        "action": "hijack-dns"
      },
      {
        "port": [
          53
        ],
        "action": "hijack-dns"
      }
    ],
    "final": "select",
    "auto_detect_interface": true,
    "override_android_vpn": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    }
  }
}
